OTP_PROVIDER_MODE=mock
# Set to 'production' to enable real SMS

# Twilio verify credentials for production
# OTP_PROVIDER_API_KEY is your Twilio Account SID
OTP_PROVIDER_API_KEY=your_twilio_account_sid_here
# OTP_PROVIDER_AUTH_TOKEN is your Twilio Auth Token
OTP_PROVIDER_AUTH_TOKEN=your_twilio_auth_token_here
# OTP_PROVIDER_SERVICE_ID is your Twilio Verify Service SID (starts with VA...)
OTP_PROVIDER_SERVICE_ID=your_twilio_verify_service_sid_here

PORT=3000
