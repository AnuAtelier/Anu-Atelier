# ==============================================================================
# Anu Atelier - Backend Environment Variables
# Single Source of Truth: Never commit real values or .env files to source control
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
APP_BASE_URL=http://localhost:5173

# Supabase Configuration
# Serverless functions use SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY
# Client (React) uses VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay Payments (Test Mode in dev, Live in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# Transactional Email (Resend)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=onboarding@resend.dev
ADMIN_ALERT_EMAIL=anushka32199@gmail.com

# Background Jobs Security (Vercel Cron / pg_cron)
CRON_SECRET=

# Observability & Security (Optional)
SENTRY_DSN=
TURNSTILE_SECRET_KEY=
